{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "track_snapshot.schema.json",
  "title": "track_snapshot",
  "description": "Version 1.0.0; design agreed, schema implementation pending team review.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "vessel_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "mmsi": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{9}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_type": {
      "enum": [
        "YANG_LEI",
        "REAL_AIS",
        "SYNTHETIC_AIS"
      ]
    },
    "is_simulated": {
      "type": "boolean"
    },
    "anchor_timestamp": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "current_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/history_point"
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history_point"
      },
      "maxItems": 10
    },
    "data_status": {
      "enum": [
        "VALID",
        "INSUFFICIENT_DATA",
        "STALE",
        "INVALID_DATA"
      ]
    }
  },
  "required": [
    "schema_version",
    "vessel_id",
    "mmsi",
    "source_type",
    "is_simulated",
    "anchor_timestamp",
    "current_state",
    "history",
    "data_status"
  ],
  "additionalProperties": false,
  "$defs": {
    "history_point": {
      "type": "object",
      "properties": {
        "nominal_timestamp": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        },
        "source_timestamp": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_source_timestamp": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "latitude": {
          "$ref": "common.schema.json#/$defs/latitude"
        },
        "longitude": {
          "$ref": "common.schema.json#/$defs/longitude"
        },
        "sog_kn": {
          "$ref": "common.schema.json#/$defs/sog_kn"
        },
        "cog_deg": {
          "$ref": "common.schema.json#/$defs/cog_deg"
        },
        "source_age_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "nominal_timestamp",
        "source_timestamp",
        "original_source_timestamp",
        "latitude",
        "longitude",
        "sog_kn",
        "cog_deg",
        "source_age_seconds"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_status": {
            "const": "VALID"
          }
        },
        "required": [
          "data_status"
        ]
      },
      "then": {
        "properties": {
          "history": {
            "minItems": 10,
            "maxItems": 10
          },
          "current_state": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "REAL_AIS"
          }
        },
        "required": [
          "source_type"
        ]
      },
      "then": {
        "properties": {
          "mmsi": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          },
          "is_simulated": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "enum": [
              "YANG_LEI",
              "SYNTHETIC_AIS"
            ]
          }
        },
        "required": [
          "source_type"
        ]
      },
      "then": {
        "properties": {
          "is_simulated": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "enum": [
              "REAL_AIS",
              "SYNTHETIC_AIS"
            ]
          },
          "data_status": {
            "const": "VALID"
          }
        },
        "required": [
          "source_type",
          "data_status"
        ]
      },
      "then": {
        "properties": {
          "history": {
            "items": {
              "properties": {
                "source_timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "source_age_seconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 60
                }
              }
            }
          }
        }
      }
    }
  ]
}
