{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "alert_v1.schema.json",
  "description": "Production V1 strict replay identity; null session retains T02/live semantics. Session isolation and atomicity require runtime checks.",
  "allOf": [
    {"$ref": "alert.schema.json"},
    {"if": {"properties": {"replay_session_id": {"type": "string"}}, "required": ["replay_session_id"]}, "then": {"properties": {
      "replay_session_id": {"$ref": "replay.schema.json#/$defs/session_id"},
      "opened_encounter_id": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^enc:v1:[0-9a-f]{64}$"},
      "latest_encounter_id": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^enc:v1:[0-9a-f]{64}$"},
      "vessel_ids": {"type": "array", "items": {"$ref": "replay.schema.json#/$defs/production_vessel_id"}}
    }}}
  ]
}
