{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "risk_response_v1.schema.json",
  "description": "Production V1 strict replay identity; null session retains T02/live semantics. Semantic hash and session checks remain runtime obligations.",
  "allOf": [
    {"$ref": "risk_response.schema.json"},
    {"if": {"properties": {"replay_session_id": {"type": "string"}}, "required": ["replay_session_id"]}, "then": {"properties": {
      "replay_session_id": {"$ref": "replay.schema.json#/$defs/session_id"},
      "encounter_id": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^enc:v1:[0-9a-f]{64}$"},
      "anchor_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
      "vessel_ids": {"type": "array", "items": {"$ref": "replay.schema.json#/$defs/production_vessel_id"}}
    }}}
  ]
}
